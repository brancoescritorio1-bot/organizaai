# .env.example
# Configurações do Supabase para o projeto 'gymxdeijrgorugqqiteh'

# URL do Projeto Supabase
SUPABASE_URL=https://gymxdeijrgorugqqiteh.supabase.co
VITE_SUPABASE_URL=https://gymxdeijrgorugqqiteh.supabase.co

# Chave Anônima/Pública (Anon Key / Publishable Key)
SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=

# Chave de Serviço/Administrador (Service Role Key / Secret Key)
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_SERVICE_ROLE_KEY=

# Chave da API do Gemini (Para recursos de inteligência artificial / IA)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
